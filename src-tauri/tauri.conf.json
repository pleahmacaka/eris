{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Eris",
  "mainBinaryName": "eris",
  "version": "0.1.0",
  "identifier": "com.arixlab.eris",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun tools/android-manifest.ts && bun run dev",
    "beforeBuildCommand": "bun run build && bun tools/android-manifest.ts"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eris",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ArixLab",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
