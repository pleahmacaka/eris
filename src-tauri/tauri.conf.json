{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "eris",
  "version": "0.1.0",
  "identifier": "com.eris.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "/",
        "title": "Eris",
        "width": 680,
        "height": 420,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false
      },
      {
        "label": "taskbar",
        "url": "/taskbar",
        "title": "Eris Taskbar",
        "width": 720,
        "height": 48,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "url": "/settings",
        "title": "Eris Settings",
        "width": 760,
        "height": 640,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "panel",
        "url": "/panel",
        "title": "Eris Panel",
        "width": 400,
        "height": 640,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "onboarding",
        "url": "/onboarding",
        "title": "Eris Setup",
        "width": 880,
        "height": 620,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      },
      {
        "label": "preview",
        "url": "/preview",
        "title": "Eris Preview",
        "width": 240,
        "height": 150,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
