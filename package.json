{
  "name": "eris-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop tauri dev",
    "build": "bun run --cwd apps/desktop tauri build",
    "check": "bun run --filter '*' check",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "icons": "bun run --cwd apps/desktop icons"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
