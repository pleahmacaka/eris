{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "*.ts",
      "*.json",
      "*.jsonc",
      "scripts/**/*.ts",
      "apps/*/src/**/*.ts",
      "apps/*/scripts/**",
      "tests/**/*.ts",
      "apps/*/tests/**/*.ts",
      "packages/*/tests/**/*.ts",
      "apps/*/*.ts",
      "apps/*/*.json",
      "packages/*/src/**/*.ts",
      "packages/*/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "#lib/dock/*",
                  "!#lib/dock/index.js",
                  "#lib/launcher/*",
                  "!#lib/launcher/index.js",
                  "#lib/panel/*",
                  "!#lib/panel/index.js",
                  "#lib/claude/*",
                  "!#lib/claude/index.js",
                  "#lib/edit/*",
                  "!#lib/edit/index.js",
                  "#lib/sync/*",
                  "!#lib/sync/index.js",
                  "#lib/data/*",
                  "!#lib/data/index.js",
                  "#lib/settings-ui/*",
                  "!#lib/settings-ui/index.js",
                  "#lib/studio/*",
                  "!#lib/studio/index.js"
                ],
                "message": "Import the feature's index (#lib/<feature>/index.js) instead of a file inside it."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
