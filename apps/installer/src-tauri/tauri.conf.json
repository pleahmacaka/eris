{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Eris Installer",
  "mainBinaryName": "eris-installer",
  "version": "../package.json",
  "identifier": "com.arixlab.eris.installer",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1460",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Eris",
        "width": 560,
        "height": 640,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "ArixLab",
    "active": true,
    "targets": [
      "appimage",
      "dmg"
    ],
    "icon": [
      "../../desktop/src-tauri/icons/32x32.png",
      "../../desktop/src-tauri/icons/128x128.png",
      "../../desktop/src-tauri/icons/128x128@2x.png",
      "../../desktop/src-tauri/icons/icon.icns",
      "../../desktop/src-tauri/icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/pleahmacaka/eris/releases/latest/download/latest.json"
      ]
    }
  }
}
