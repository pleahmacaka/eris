{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "eris",
  "version": "../package.json",
  "identifier": "com.eris.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "/",
        "title": "Eris",
        "width": 680,
        "height": 420,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing"
      },
      {
        "label": "taskbar",
        "url": "/taskbar",
        "title": "Eris Taskbar",
        "width": 720,
        "height": 48,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing"
      },
      {
        "label": "settings",
        "url": "/settings",
        "title": "Eris Settings",
        "width": 760,
        "height": 640,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing",
        "create": false
      },
      {
        "label": "panel",
        "url": "/panel",
        "title": "Eris Panel",
        "width": 900,
        "height": 620,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing",
        "create": false
      },
      {
        "label": "onboarding",
        "url": "/onboarding",
        "title": "Eris Setup",
        "width": 880,
        "height": 620,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing",
        "create": false
      },
      {
        "label": "preview",
        "url": "/preview",
        "title": "Eris Preview",
        "width": 240,
        "height": 150,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing"
      },
      {
        "label": "chat",
        "url": "/chat",
        "title": "Claude",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing"
      },
      {
        "label": "files",
        "url": "/files",
        "title": "Eris Files",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 460,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing",
        "create": false
      },
      {
        "label": "edit",
        "url": "/edit",
        "title": "Eris Edit",
        "width": 800,
        "height": 600,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu-compositing",
        "create": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQTg1M0I3QkZCRDg4QTAKUldTZ2lMMi90MU9vc1V2alhjR3BKdlgxZERmV0dDcm8xSFRzUWk5TGFCdHl4ek1tOUxOcGJiT2UK",
      "endpoints": [
        "https://github.com/pleahmacaka/eris/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
