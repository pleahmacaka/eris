{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "root": false,
  "files": {
    "includes": ["src/**/*.ts", "tests/**/*.ts", "scripts/**", "*.ts", "*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded",
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useBlockStatements": "error" },
      "suspicious": { "noExplicitAny": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
