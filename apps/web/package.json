    "@eris/settings": "workspace:*",
    "@eris/ui": "workspace:*",
    "@iconify/svelte": "^5.2.2",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.143",
